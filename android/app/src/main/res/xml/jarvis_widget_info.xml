<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata for JarvisWidgetProvider.kt (Runde 14, Einheit 9). 30-minute
     updatePeriodMillis matches BackgroundTaskService's syncDashboardTask —
     Android enforces this as a hard floor for automatic widget updates
     anyway, so the WorkManager task (which can run more precisely, and
     also on-demand via HomeWidgetService.refresh()) is the real freshness
     mechanism, this is only the native fallback. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/jarvis_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher">
</appwidget-provider>
